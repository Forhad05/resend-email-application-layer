{
  "name": "email-application",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "docker compose up -d postgres && npx concurrently -k -n \"next,tunnel\" -c \"cyan,magenta\" \"next dev\" \"npx wait-on tcp:3000 && cloudflared tunnel --url http://localhost:3000\"",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "docker:up": "docker compose up -d",
    "docker:tunnel": "docker compose --profile tunnel up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "better-auth": "^1.7.10",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.57.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "postal-mime": "^4.1.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.32.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
