{
  "name": "email-application",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "docker compose up -d postgres && npx concurrently -k -n \"next,tunnel\" -c \"cyan,magenta\" \"next dev\" \"npx wait-on tcp:3000 && cloudflared tunnel --url http://localhost:3000\"",
    "db:run": "docker run --name email-tool-postgres -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=email_tool -p 5432:5432 -v postgres_data:/var/lib/postgresql/data --restart unless-stopped -d docker.io/library/postgres:16-alpine",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "tunnel:start": "docker compose up -d tunnel",
    "tunnel:stop": "docker compose stop tunnel",
    "tunnel:logs": "docker compose logs -f tunnel",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:smoke": "tsx scripts/test-smoke.ts",
    "test:webhooks": "tsx scripts/test-webhooks.ts",
    "test:stress": "tsx scripts/test-stress.ts",
    "test:fuzz": "tsx scripts/test-fuzz.ts",
    "test:all": "tsx scripts/test-smoke.ts && tsx scripts/test-webhooks.ts && tsx scripts/test-stress.ts && tsx scripts/test-fuzz.ts"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.3.1",
    "better-auth": "^1.7.10",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.57.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "postal-mime": "^4.1.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.32.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
