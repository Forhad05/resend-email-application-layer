# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==============================================================================
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/email_tool"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgrespass"
POSTGRES_DB="email_tool"
POSTGRES_PORT="5432"

# ==============================================================================
# RESEND CONFIGURATION
# ==============================================================================
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY="re_your_api_key_here"

# Webhook secret from Resend dashboard (starts with whsec_)
RESEND_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

# Verified sending domain / sender email in Resend
EMAIL_FROM="Support <support@mail.yourdomain.com>"

# ==============================================================================
# AUTHENTICATION & APP CONFIGURATION (Better Auth)
# ==============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET="your_generated_random_secret_here"
NEXT_PUBLIC_APP_NAME="SystemDevify"

# ==============================================================================
# AI REPLY ASSISTANT (Optional - Google Gemini)
# ==============================================================================
GEMINI_API_KEY="your_gemini_api_key_here"

# ==============================================================================
# OUTBOUND RATE LIMITING (Sliding Window per Minute)
# ==============================================================================
RATE_LIMIT_USER_MAX="25"
RATE_LIMIT_IP_MAX="30"
RATE_LIMIT_RECIPIENT_MAX="5"
RATE_LIMIT_TX_MAX="3"

# ==============================================================================
# OBSIDIAN INTEGRATION (Vault Documentation Sync)
# ==============================================================================
OBSIDIAN_API_KEY="your_obsidian_api_key_here"
OBSIDIAN_VAULT_PATH="/path/to/your/obsidian/vault"

# ==============================================================================
# CLOUDFLARE PERMANENT NAMED TUNNEL
# ==============================================================================
CLOUDFLARE_TUNNEL_ID="your_tunnel_uuid_here"
CLOUDFLARE_TUNNEL_TOKEN="your_cloudflare_tunnel_token_here"
TUNNEL_TOKEN="your_cloudflare_tunnel_token_here"
CLOUDFLARE_PUBLISHED_ROUTE="your_cloudflare_published_url"
